# --- Terragrunt ---
# Local backend state. Contains the resolved DB password and the Secrets
# Manager secret_string in plaintext -- never commit it. Moving state into
# floci does not help here: the file still lands on disk.
.state/

# Per-stack working copies of the modules plus generated provider/backend
# files. Pure build artefacts; ~660 files of noise in a diff.
.terragrunt-cache/
.tfplan/
tg-gen-*.tf
dynamic_modules.tf

# Merged stack outputs, rebuilt by scripts/lib/outputs.sh on demand.
.outputs.json

# --- Terraform ---
# State carries the resolved DB password and the Secrets Manager secret_string
# in plaintext. It must never be committed, even for a local-only demo.
terraform.tfstate
terraform.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
*.tfplan

# --- Generated at deploy time ---
# Rendered from Secrets Manager by scripts/render-k8s-config.sh and contains
# DB_PASSWORD in cleartext. Regenerate it, never commit it.
k8s/01-config.yaml

# Written by scripts/deploy-frontend.sh and scripts/build-and-push.sh
dist/
build-images.txt

# --- Node ---
node_modules/
npm-debug.log*

# --- Local scratch ---
repro/
*.zip
.DS_Store
kubeconfig


# --- Symlinks ---
# Mirrors of root files plus .opencode, kept for browsing only.
# ripgrep-based search respects gitignore, so listing them here keeps
# grep/glob from returning each file twice. Read the root originals.
docs/AGENTS.md
docs/K8-commands.md
docs/LEARNINGS.md
docs/PG_initiate.md
docs/README.md
docs/opencode-dot

# --- Local Track files ---
CHANGELOG.md
LEARNINGS.md
JOURNAL.md
TROUBLESHOOT.md
PG_initiate.md
K8-commands.md