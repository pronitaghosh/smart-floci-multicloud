%{ for dist in cloudfront_distributions ~}
# Real CloudFront requires its ACM certificate in us-east-1 regardless of where
# the rest of the stack lives, which is a genuine reason for a second provider.
module "cloudfront_cert_${replace(dist.name, "-", "_")}" {
  source        = "../acm-certificate"
  global_config = local.global
  acm_config    = [{
    name        = "${dist.certificate_name}"
    domain_name = "${try(dist.aliases[0], "")}"
  }]

  providers = {
    aws = aws.${try(dist.certificate_provider_alias, "us_east_1")}
  }
}
%{ endfor ~}
